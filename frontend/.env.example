# API Configuration
VITE_API_URL=/api/v1

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
# For local testing, you can use "test" as placeholder
VITE_WALLET_CONNECT_PROJECT_ID=test

# Smart Contract Factory Addresses (per chain)
# The app automatically selects the right address based on connected network

# Hardhat Local (Chain ID: 31337) - Used for local development
VITE_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Sepolia Testnet (Chain ID: 11155111) - Optional, for testnet deployment
# VITE_SEPOLIA_FACTORY_ADDRESS=0x...

# Ethereum Mainnet (Chain ID: 1) - Optional, for production
# VITE_MAINNET_FACTORY_ADDRESS=0x...

# Pinata IPFS Configuration
# Get your keys at: https://app.pinata.cloud/developers/api-keys
#
# Option 1: JWT Token (recommended - single value)
# Generate a JWT from the Pinata dashboard
# VITE_PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Option 2: API Key + Secret (two separate values)
# VITE_PINATA_API_KEY=your_api_key
# VITE_PINATA_SECRET=your_api_secret

# IPFS Gateway URL (optional, defaults to Pinata gateway)
# VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
